<Window x:Class="ScreenPlus.UI.MainWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ScreenPlus.UI"
        Title="ScreenPlus" Width="1180" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/ScreenPlus;component/Assets/AppIcon.ico" UseLayoutRounding="True">
    <Grid>
        <!-- Home, and the states around recording -->
        <Grid x:Name="Home" Margin="32">
            <StackPanel x:Name="IdlePanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                <Grid Width="64" Height="64" HorizontalAlignment="Center">
                    <Ellipse Stroke="{StaticResource RecordRedBrush}" StrokeThickness="4" />
                    <Ellipse Width="28" Height="28" Fill="{StaticResource RecordRedBrush}" />
                </Grid>
                <TextBlock Margin="0,18,0,0" TextAlignment="Center" TextWrapping="Wrap" FontSize="14"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Record your screen. ScreenPlus zooms in where you work and out when you stop." />
                <Button Margin="0,18,0,0" HorizontalAlignment="Center" Padding="22,8" FontSize="14"
                        Style="{DynamicResource AccentButtonStyle}" Content="New Recording" Click="OnNewRecording"
                        ToolTip="Ctrl+N" />
                <Button Margin="0,14,0,0" HorizontalAlignment="Center" Style="{StaticResource LinkButton}"
                        Content="Open Previous Recording…" Click="OnOpen" />
                <TextBlock Margin="0,18,0,0" TextAlignment="Center" Style="{StaticResource Caption}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Opens the floating recording toolbar. The toolbar never appears in recordings." />
            </StackPanel>

            <StackPanel x:Name="BusyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <ProgressBar IsIndeterminate="True" Width="220" />
                <TextBlock x:Name="BusyText" Margin="0,12,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Starting…" />
            </StackPanel>

            <StackPanel x:Name="RecordingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="26" Height="26" Fill="{StaticResource RecordRedBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="RecordingTime" Margin="12,0,0,0" FontSize="32" FontWeight="SemiBold"
                               Foreground="{StaticResource RecordRedBrush}" Typography.NumeralAlignment="Tabular" Text="0:00" />
                </StackPanel>
                <Button Margin="0,18,0,0" HorizontalAlignment="Center" Padding="22,8" FontSize="14"
                        Style="{DynamicResource AccentButtonStyle}" Content="Stop Recording" Click="OnStop"
                        ToolTip="Ctrl+Shift+R" />
            </StackPanel>

            <StackPanel x:Name="FailedPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560"
                        Visibility="Collapsed">
                <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="40"
                           Foreground="#F7A600" Text="&#xE7BA;" />
                <TextBlock x:Name="FailureText" Margin="0,14,0,0" TextAlignment="Center" TextWrapping="Wrap" FontSize="14"
                           Text="{Binding FailureMessage}" />
                <Button Margin="0,18,0,0" HorizontalAlignment="Center" Padding="22,6" Style="{DynamicResource AccentButtonStyle}"
                        Content="Back" Click="OnBack" />
            </StackPanel>
        </Grid>

        <ui:EditorView x:Name="Editor" Visibility="Collapsed" />
    </Grid>
</Window>
